# ─── Required ────────────────────────────────────────────────────────────────

# Doorbell (Hikvision DS-KV8113 and similar) - IP and admin account used for ISAPI.
HIK_IP=192.168.1.50
HIK_USERNAME=admin
HIK_PASSWORD=change-me

# Access to this app. Set at least one of (or TRUST_LOCAL_NETWORK below):
#  - APP_PASSWORD: browser login (HTTP Basic, user APP_USERNAME)
#  - APP_TOKEN: for the Windows client, Home Assistant and other devices
#    (Authorization: Bearer <token> or ?token=<token> in the URL).
#    Generate one with:  openssl rand -hex 24
APP_USERNAME=admin
APP_PASSWORD=
APP_TOKEN=
# No login for devices on the local network (private IPs). Requests through a proxy or
# tunnel (e.g. Cloudflare) still need APP_TOKEN / APP_PASSWORD.
TRUST_LOCAL_NETWORK=false
# Only for a trusted LAN without internet exposure: disables all authentication.
AUTH_DISABLED=false

# ─── Video and two-way audio (go2rtc) ────────────────────────────────────────

# Address of go2rtc as seen from THIS server (LAN address is best). The browser
# never connects to go2rtc directly - traffic goes through the app's /go2rtc proxy,
# so go2rtc does not need to be exposed to the internet.
GO2RTC_URL=http://192.168.1.10:1984
GO2RTC_USERNAME=
GO2RTC_PASSWORD=
GO2RTC_STREAM_NAME=doorbell
GO2RTC_MEDIA=video+audio+microphone
# Only for the bundled go2rtc (docker compose --profile go2rtc): set GO2RTC_URL=http://go2rtc:1984
# and the LAN IP of the Docker host, which browsers use for WebRTC media.
DOCKER_HOST_IP=

# ─── Optional ────────────────────────────────────────────────────────────────

PORT=8090
# Prebuilt image to use instead of building locally (see docker-compose.yml).
HIK_DOORBELL_IMAGE=
# Only needed if the UI is served from a different origin than the API.
UI_ORIGIN=
HIK_DOOR_INDEX=1
HIK_CALLSTATUS_POLL_MS=1000
HIK_ACCEPT_STRATEGY=answer_hangup
HIK_ACCEPT_DELAY_MS=500
HIK_IGNORE_IDLE_AFTER_ACCEPT_MS=120000
HIK_ENDCALL_RETRY_DELAY_MS=1500
